---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { parseFlexibleDate, formatDate } from '@lib/dates';

const rawContribs = (await getCollection('contributions')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);

const contributions = await Promise.all(
  rawContribs.map(async (c) => {
    const events = c.data.events
      ? (await Promise.all(c.data.events.map((ref) => getEntry(ref)))).filter(Boolean)
      : [];
    const artworks = c.data.artworks
      ? (await Promise.all(c.data.artworks.map((ref) => getEntry(ref)))).filter(Boolean)
      : [];
    return {
      ...c,
      displayDate: formatDate(parseFlexibleDate(c.data.date)),
      events,
      artworks,
    };
  })
);
---

<BaseLayout title="About" description="About the Net Art Extinction Timeline project and how to contribute.">
  <div class="container prose">
    <h1>About</h1>

    <p>
      The <strong>Net Art Extinction Timeline</strong> documents how dependency changes — API shutdowns, plugin end-of-lifes, browser removals, platform closures — break digital artworks. It is a living archive of technological extinction events and their impact on creative works.
    </p>

    <p>
      Many digital artworks depend on external services, browser plugins, or platform features that their creators do not control. When these dependencies disappear, the artworks break — sometimes overnight. This project tracks those moments of breakage, preserving the record of what was lost and how.
    </p>

    <h2>Who maintains this?</h2>
    <p>
      The Net Art Extinction Timeline is an official <strong>open-source project of <a href="https://zkm.de" target="_blank" rel="noopener">ZKM | Zentrum für Kunst und Medien Karlsruhe</a></strong>, developed and maintained by <a href="https://marc-schuetze.de" target="_blank" rel="noopener">Marc Schütze</a>.
    </p>

    <h2>Why "extinction"?</h2>
    <p>
      Net-art works go <em>extinct</em> the way species do: not by being deleted, but by losing the
      environment they need to live. When the plugin, the server, the browser, or the platform an
      artwork depends on disappears, the work goes dark. This is a <strong>timeline</strong> of those
      moments — a record of what broke, when, and why. Its companion project,
      <a href="https://vmctl.org" target="_blank" rel="noopener">vmctl</a> (also a ZKM open-source
      project), works the other end of the problem: bringing such works back to life inside faithful
      period machines.
    </p>

    <h2>Contributors</h2>
    <p>
      The archive grows through first-person contributions from artists, researchers, and witnesses to digital obsolescence.
    </p>
    <ul class="contributors">
      {contributions.map((c) => (
        <li id={`contributor-${c.id}`}>
          <div class="contrib-head">
            <strong>{c.data.name}</strong>
            {c.data.affiliation && <span class="affiliation">— {c.data.affiliation}</span>}
            <time datetime={c.data.date}> · {c.displayDate}</time>
          </div>
          <p class="contrib-summary">{c.data.summary}</p>
          {(c.events.length + c.artworks.length) > 0 && (
            <ul class="contrib-items">
              {c.events.map((e: any) => (
                <li>Event: <a href={`/events/${e.id}`}>{e.data.title}</a></li>
              ))}
              {c.artworks.map((a: any) => (
                <li>Artwork: <a href={`/artworks/${a.id}`}>{a.data.title}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <h2>Submit an event or artwork</h2>
    <p>
      We welcome contributions from researchers, artists, curators, and anyone who has witnessed a digital artwork break due to a dependency change. There are two ways to submit:
    </p>

    <h3>1. GitHub Issue Form (easiest)</h3>
    <p>
      Use our structured forms to report events or artworks. A maintainer will review your submission and merge it.
    </p>
    <ul>
      <li><a href="https://github.com/zkmkarlsruhe/netart-extinction/issues/new/choose">Report an extinction event or affected artwork</a></li>
    </ul>

    <h3>2. Pull Request</h3>
    <p>
      Fork the repository, add a Markdown file to <code>src/content/events/</code> or <code>src/content/artworks/</code>, and open a PR. See <a href="https://github.com/zkmkarlsruhe/netart-extinction/blob/main/CONTRIBUTING.md">CONTRIBUTING.md</a> for templates and guidelines.
    </p>

    <h2>Cite this project</h2>
    <p>
      This project is archived on Zenodo: <a href="https://doi.org/10.5281/zenodo.19254683" target="_blank" rel="noopener">DOI 10.5281/zenodo.19254683</a>
    </p>

    <h2>License</h2>
    <p>
      Content is licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>. Code is <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener">MIT</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .contributors {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }

  .contributors > li {
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }

  .contrib-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .contrib-head .affiliation {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .contrib-head time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-left: auto;
  }

  .contrib-summary {
    margin: var(--space-sm) 0 0;
  }

  .contrib-items {
    margin: var(--space-sm) 0 0;
    padding-left: var(--space-lg);
    font-size: 0.9375rem;
  }

  .contrib-links {
    margin: var(--space-sm) 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .contrib-links a {
    color: var(--text-muted);
  }
</style>
