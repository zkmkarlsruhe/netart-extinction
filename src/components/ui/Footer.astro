<footer>
  <div class="container">
    <!-- tier 1: legal links (left) + project/social links (right) — zkm.de legal row -->
    <div class="footer-legal">
      <nav class="footer-links">
        <a href="/impressum">Impressum</a>
        <a href="/privacy">Datenschutz</a>
      </nav>
      <nav class="footer-links">
        <a href="https://github.com/zkmkarlsruhe/netart-extinction" target="_blank" rel="noopener">GitHub</a>
        <a href="https://github.com/zkmkarlsruhe/netart-extinction/issues/new/choose">Beitrag einreichen</a>
      </nav>
    </div>

    <!-- tier 2: ZKM logo + 3-column contact block — zkm.de contact row -->
    <div class="footer-contact">
      <a class="footer-zkm" href="https://zkm.de" target="_blank" rel="noopener" title="ZKM | Zentrum für Kunst und Medien Karlsruhe">
        <img src="/zkm-logo.svg" alt="ZKM | Zentrum für Kunst und Medien Karlsruhe" width="98" height="82" />
      </a>
      <address class="footer-addr">
        <span>ZKM&nbsp;|&nbsp;Zentrum für<br />Kunst und Medien Karlsruhe</span>
        <span>Lorenzstraße 19<br />76135 Karlsruhe</span>
        <span>+49&nbsp;(0)&nbsp;721&nbsp;&ndash;&nbsp;8100&nbsp;&ndash;&nbsp;1200<br /><a href="mailto:info@zkm.de">info@zkm.de</a></span>
      </address>
    </div>

    <!-- tier 3: project attribution -->
    <p class="footer-copy">
      &copy; 2026 <a href="https://zkm.de" target="_blank" rel="noopener">ZKM&nbsp;|&nbsp;Zentrum für Kunst und Medien Karlsruhe</a>.
      An official ZKM open-source project, developed by Marc Schütze.
      Content <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC&nbsp;BY&nbsp;4.0</a>,
      code <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener">MIT</a>.
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-xl);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .footer-links a {
    color: var(--heading);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .footer-contact {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xl);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border);
  }

  .footer-zkm {
    flex-shrink: 0;
    display: block;
  }

  .footer-zkm img {
    height: 4.5rem;
    width: auto;
  }

  [data-theme="dark"] .footer-zkm img {
    filter: invert(1);
  }

  .footer-addr {
    font-style: normal;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    color: var(--text);
    line-height: 1.5;
    flex: 1;
  }

  .footer-addr a {
    color: var(--heading);
  }

  .footer-copy {
    margin: var(--space-lg) 0 0;
    max-width: 60rem;
  }

  .footer-copy a {
    color: var(--heading);
  }

  @media (max-width: 640px) {
    .footer-contact {
      flex-direction: column;
      gap: var(--space-lg);
    }

    .footer-addr {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
